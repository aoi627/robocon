#define ENCODER_A 11
#define MOTER_DIR 4
#define MOTER_PWM 5

#define PPR 400

//P制御設定
float targetRPM = 100; //目標回転数
float Kp = 2.0; //比例ゲイン


//パルスを数える変数
volatile long pulseCount = 0;

unsigned long previousTime = 0;

//P制御のための変数
float rpm = 0;
float error = 0;
float pwm = 0;

void encoderISR() {
  pulseCount++; //パルスがきたら1ずつふやす
}

void setup() {
    Serial.begin(9600);
    pinMode(ENCODER_A, INPUT_PULLUP);

    attachInterrupt(  //割り込みの設定
        digitalPinToInterrupt(ENCODER_A), encoderISR,
        RISING
    );

    previousTime = millis();

    //もたどらの設定
    pinMode(MOTER_DIR, OUTPUT);
    pinMode(MOTER_PWM, OUTPUT);

    //モータの回転方向を設定
    digitalWrite(MOTER_DIR, HIGH); //HIGHで正転、LOWで逆



}

void loop() {

    unsigned long currentTime = millis();

    if (currentTime - previousTime >= 1000) { //1秒ごとに計算
        noInterrupts(); //割り込みを停止
        long pulses = pulseCount; //パルスの数をコピー
        pulseCount = 0; //パルスの数をリセット
        interrupts(); //割り込みを再開
    

    rpm = (float)pulses / PPR * 60.0; //RPMの計算
    error = targetRPM - rpm; //誤差の計算
    pwm = Kp * error; //PWM出力の計算

    pwm = constrain(pwm, 0, 255); //PWM出力を0~255に制限
    analogWrite(MOTER_PWM, (int)pwm); //PWM出力

    Serial.print("Target RPM = ");
    Serial.print(targetRPM);

    Serial.print("   RPM = ");
    Serial.print(rpm);

    Serial.print("   Error = ");
    Serial.print(error);

    Serial.print("   PWM = ");
    Serial.println(pwm);
    
    //時間更新
    previousTime = currentTime;

}
}